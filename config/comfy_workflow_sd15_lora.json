{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {"ckpt_name": "%ckpt%"}
  },
  "10": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["4", 0],
      "clip": ["4", 1],
      "lora_name": "%lora%",
      "strength_model": %lora_w%,
      "strength_clip": %lora_w%
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {"clip": ["10", 1], "text": "%prompt%"}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["10", 1],
      "text": "text, letters, watermark, signature, people, person, character, lowres, blurry, jpeg artifacts, worst quality, low quality"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {"width": 768, "height": 448, "batch_size": 1}
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0],
      "seed": %seed%,
      "steps": 28,
      "cfg": 7,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {"images": ["8", 0], "filename_prefix": "teste_loop_base"}
  }
}
