    {"reference_start_sec": 72.31, "text": "Tennurnar mínar naga", "section": "verse"},
    {"reference_start_sec": 74.01, "text": "Höfuðið mitt er að springa", "section": "verse"},
    {"reference_start_sec": 75.77, "text": "Dýrið vaknar að nýju", "section": "verse"},
    {"reference_start_sec": 78.65, "text": "Haltu veiðinni áfram - the war drum under my skin", "section": "pre-chorus 2"},
    {"reference_start_sec": 82.89, "text": "Chain by chain, I grin as the cage caves in", "section": "pre-chorus 2"},
    {"reference_start_sec": 89.19, "text": "The beast beneath my skin", "section": "chorus"},
    {"reference_start_sec": 92.39, "text": "Won't let me rest again", "section": "chorus"},
