    {"reference_start_sec": 106.86, "text": "break in, break in", "section": "chorus"},
    {"reference_start_sec": 142.60, "text": "Hands on the wheel, red lights carved in chrome", "section": "rap verse"},
    {"reference_start_sec": 143.97, "text": "Wolf in a dress shirt, pulse buried under snow", "section": "rap verse"},
    {"reference_start_sec": 145.54, "text": "They call it a life, but I hear the old drum", "section": "rap verse"},
    {"reference_start_sec": 147.49, "text": "Haltu veiðinni áfram - I was never far from", "section": "rap verse"},
    {"reference_start_sec": 149.09, "text": "Chain on my name, but the blood won't sit still", "section": "rap verse"},
    {"reference_start_sec": 150.86, "text": "Forfeður kalla from the dark of the hill", "section": "rap verse"},
    {"reference_start_sec": 152.72, "text": "Undir húðinni, something starts breathing", "section": "rap verse"},
    {"reference_start_sec": 154.03, "text": "Ég er dýrið - now the silence has meaning", "section": "rap verse"},
    {"reference_start_sec": 155.91, "text": "Hjartað slær eins og hamar - hit-hit, harder", "section": "rap verse"},
    {"reference_start_sec": 158.09, "text": "Ice in the marrow, fire in the armor", "section": "rap verse"},
    {"reference_start_sec": 159.96, "text": "Clock in, boxed in, lungs getting smaller", "section": "rap verse"},
    {"reference_start_sec": 161.75, "text": "Haltu veiðinni áfram - the old gods holler", "section": "rap verse"},
    {"reference_start_sec": 163.16, "text": "Ég er dýrið, can you feel it? Can you hear it?", "section": "rap verse"},
    {"reference_start_sec": 164.21, "text": "No more mirror, no more mask, no more spirit to bury", "section": "rap verse"},
    {"reference_start_sec": 165.69, "text": "Beneath it, I breathe it, I bleed it, I steer it", "section": "rap verse"},
    {"reference_start_sec": 167.27, "text": "Ég er dýrið! Ég er dýrið! Don't fear it!", "section": "rap verse"},
    {"reference_start_sec": 169.88, "text": "One slow breath - I don't run, I don't kneel", "section": "rap verse"},
    {"reference_start_sec": 172.73, "text": "Ég er dýrið - I can feel their fear", "section": "rap verse"},
    {"reference_start_sec": 174.29, "text": "The beast is awake, but I hold the steel", "section": "rap verse"},
    {"reference_start_sec": 176.26, "text": "Haltu veiðinni áfram", "section": "rap verse"},
    {"reference_start_sec": 178.95, "text": "I've always been real", "section": "rap verse"},
    {"reference_start_sec": 187.65, "text": "Ég er dýrið, I feel it, I feed it within", "section": "pre-chorus"},
    {"reference_start_sec": 190.89, "text": "Haltu veiðinni áfram", "section": "pre-chorus"},
    {"reference_start_sec": 193.71, "text": "let the hunt become hymn", "section": "pre-chorus"},
    {"reference_start_sec": 198.93, "text": "The beast beneath my skin", "section": "final chorus"},
    {"reference_start_sec": 202.31, "text": "Has finally broken in", "section": "final chorus"},
